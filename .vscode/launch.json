{
    "version": "0.2.0",
    "configurations": [
                {
            "type": "julia",
            "request": "launch",
            "name": "Debug: [01] A5 mesh generate level 16, Standard flow model",
            "program": "${file}",
            "args": [
                "--meshgen", "test/kaiapoi_aoi.geojson", 
                "--meshres", "16",
                "--meshout", "test/kaiapoi_mesh16_standard.parquet",
                "--dem", "test/kaiapoi_dem.tif",
                "--rainfall", "50", 
                "--output", "test/kaiapoi_test01.h5",
                "--output-interval", "3600",
                "--sim-duration", "72000",
                "--flow-model", "standard"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "Debug: [01] A5 mesh generate level 16, Standard flow model",
                "JULIA_DEBUG": "Main"
            }
        },
