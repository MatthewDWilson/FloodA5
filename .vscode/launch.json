                "16",
                "--meshout",
                "test/kaiapoi_mesh16_standard.parquet",
                "--dem",
                "test/kaiapoi_dem.tif",
                "--rainfall",
                "50",
                "--output",
                "test/kaiapoi_test06.h5",
                "--output-interval",
                "900",
                "--sim-duration",
                "7200",
                "--flow-model",
                "standard"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[06] Standard A5 mesh followed by standard flow model",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "[07] Flat mesh gen \u2014 no DEM, standard, res 14 (rainpoint test prerequisite)",
