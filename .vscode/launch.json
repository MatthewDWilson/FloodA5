{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "julia",
            "request": "launch",
            "name": "[00] Write flat test AOI GeoJSON (run once before [07])",
            "program": "${workspaceFolder}/test_flat_rainpoint.jl",
            "args": [
                "--gen"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[00] Write flat test AOI GeoJSON (run once before [07])",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "[01] Standard A5 mesh (geometry + neighbours + elevation + cell area)",
            "program": "${workspaceFolder}/FloodModel.jl",
            "args": [
                "--meshgen",
                "test/kaiapoi_aoi.geojson",
                "--meshres",
                "16",
                "--meshout",
                "test/kaiapoi_mesh16_standard.parquet",
                "--dem",
                "test/kaiapoi_dem.tif",
                "--mesh-only"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[01] Standard A5 mesh (geometry + neighbours + elevation + cell area)",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "[02] SGS-ready mesh (adds hypsometric tables)",
            "program": "${workspaceFolder}/FloodModel.jl",
            "args": [
                "--meshgen",
                "test/kaiapoi_aoi.geojson",
                "--meshres",
                "16",
                "--meshout",
                "test/kaiapoi_mesh16_sgs.parquet",
                "--dem",
                "test/kaiapoi_dem.tif",
                "--mesh-only",
                "--flow-model",
                "sgs"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[02] SGS-ready mesh (adds hypsometric tables)",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "[03] Run standard simulation (mesh must exist)",
            "program": "${workspaceFolder}/FloodModel.jl",
            "args": [
                "--meshload",
                "test/kaiapoi_mesh16_standard.parquet",
                "--rainfall",
                "50",
                "--output",
                "test/kaiapoi_test03.h5",
                "--output-interval",
                "900",
                "--sim-duration",
                "7200",
                "--flow-model",
                "standard",
                "--vis",
                "makie"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[03] Run standard simulation (mesh must exist)",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
            "name": "[04] Run SGS simulation (mesh must have been built with --flow-model sgs)",
            "program": "${workspaceFolder}/FloodModel.jl",
            "args": [
                "--meshload",
                "test/kaiapoi_mesh16_sgs.parquet",
                "--rainfall",
                "50",
                "--output",
                "test/kaiapoi_test04.h5",
                "--output-interval",
                "900",
                "--sim-duration",
                "7200",
                "--flow-model",
                "sgs",
                "--vis",
                "makie"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[04] Run SGS simulation (mesh must have been built with --flow-model sgs)",
                "JULIA_DEBUG": "Main"
            }
        },
