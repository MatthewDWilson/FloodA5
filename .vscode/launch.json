        },
                {
            "type": "julia",
            "request": "launch",
            "name": "[Carlise 01] Standard A5 mesh (geometry + neighbours + elevation + cell area)",
            "program": "${workspaceFolder}/FloodModel.jl",
            "args": [
                "--meshgen",    "test/carlisle/Carlisle_domain.geojson",
                "--meshres",    "16",
                "--meshout",    "test/carlisle/carlisle_mesh16_standard.parquet",
                "--dem",        "test/carlisle/Carlisle_LiDAR_5m_mean.tif",
