                "-43.4043,172.6644,50.0",
                "--sim-duration",
                "3600",
                "--dt-max",
                "30",
                "--output",
                "test/flat_rainpoint_out.h5",
                "--output-interval",
                "300"
            ],
            "env": {
                "DEBUG_PROFILE_NAME": "[08] Flat rainpoint \u2014 single cell source, standard flow, no vis",
                "JULIA_DEBUG": "Main"
            }
        },
        {
            "type": "julia",
            "request": "launch",
